# llmgate configuration
# cp llmgate.toml.example llmgate.toml, then fill in API keys
# SDK: load explicitly via llmgate.NewFromFile("llmgate.toml")
# Server: go run ./examples/server [path/to/llmgate.toml]
#
# Model can be specified at request time (req.Model) or configured per provider
# below as default_model. If neither is set, each provider uses its built-in default:
#   anthropic   -> claude-sonnet-4-6
#   azure       -> gpt-5.5
#   baichuan    -> Baichuan4
#   cerebras    -> gpt-oss-120b
#   cloudflare  -> @cf/zai-org/glm-5.2
#   deepseek    -> deepseek-v4-pro
#   doubao      -> doubao-seed-2-0-pro-260215
#   ernie       -> ernie-5.1
#   gemini      -> gemini-3.1-flash
#   glm         -> glm-5.2
#   grok        -> grok-4.3
#   groq        -> meta-llama/llama-4-maverick-17b-128e
#   hunyuan     -> hy3-preview
#   kimi        -> kimi-k2.6
#   llama       -> llama-4-maverick
#   mimo        -> mimo-v2-pro
#   minimax     -> MiniMax-M3
#   mistral     -> mistral-large-latest
#   nvidia      -> nvidia/nemotron-3-super-120b-a12b
#   openai      -> gpt-5.5
#   perplexity  -> sonar-pro
#   qwen        -> qwen3.7-max
#   sensenova   -> sensenova-6.7-flash-lite
#   siliconflow -> Qwen/Qwen3-72B
#   spark       -> spark-x2
#   stepfun     -> step-3.7-flash
#   together    -> meta-llama/Llama-4-Maverick-17B-128E-Instruct-FP8
#   yi          -> yi-lightning

[[providers]]
name = "anthropic"
key = "${ANTHROPIC_KEY}"
# base_url = "https://api.anthropic.com/v1"

[[providers]]
name = "azure"
key = "${AZURE_KEY}"
# Azure requires base_url to match your deployed resource.
# Format: https://<resource-name>.openai.azure.com/openai/v1
# Also set default_model to the deployment name.
# base_url = "https://my-resource.openai.azure.com/openai/v1"

[[providers]]
name = "baichuan"
key = "${BAICHUAN_KEY}"
# base_url = "https://api.baichuan-ai.com/v1"

[[providers]]
name = "cerebras"
key = "${CEREBRAS_KEY}"
# base_url = "https://api.cerebras.ai/v1"

[[providers]]
name = "cloudflare"
key = "${CLOUDFLARE_KEY}"
# Cloudflare AI Gateway requires base_url with account_id and gateway_id.
# base_url = "https://gateway.ai.cloudflare.com/v1/<ACCOUNT_ID>/<GATEWAY_ID>"

[[providers]]
name = "deepseek"
key = "${DEEPSEEK_KEY}"
# base_url = "https://api.deepseek.com/v1"

[[providers]]
name = "doubao"
key = "${DOUBAO_KEY}"
# base_url = "https://ark.cn-beijing.volces.com/api/v3"

[[providers]]
name = "ernie"
key = "${ERNIE_KEY}"
# base_url = "https://qianfan.baidubce.com/v2"

[[providers]]
name = "gemini"
key = "${GEMINI_KEY}"
# base_url = "https://generativelanguage.googleapis.com/v1beta"

[[providers]]
name = "glm"
key = "${GLM_KEY}"
# base_url: override for third-party cloud vendors that resell GLM (e.g. Alibaba Bailian, Tencent Cloud)
# base_url = "https://open.bigmodel.cn/api/paas/v4"

[[providers]]
name = "grok"
key = "${GROK_KEY}"
# base_url = "https://api.x.ai/v1"

[[providers]]
name = "groq"
key = "${GROQ_KEY}"
# base_url = "https://api.groq.com/openai/v1"

[[providers]]
name = "hunyuan"
key = "${HUNYUAN_KEY}"
# base_url = "https://api.hunyuan.cloud.tencent.com/v1"

[[providers]]
name = "kimi"
key = "${KIMI_KEY}"
# base_url = "https://api.moonshot.cn/v1"

[[providers]]
name = "llama"
key = "${LLAMA_KEY}"
# base_url = "https://api.llama.com/v1"

[[providers]]
name = "mimo"
key = "${MIMO_KEY}"
# base_url = "https://api.xiaomimimo.com/v1"

[[providers]]
name = "minimax"
key = "${MINIMAX_KEY}"
# base_url = "https://api.minimaxi.com/v1"

[[providers]]
name = "mistral"
key = "${MISTRAL_KEY}"
# base_url = "https://api.mistral.ai/v1"

[[providers]]
name = "nvidia"
key = "${NVIDIA_KEY}"
# base_url = "https://integrate.api.nvidia.com/v1"

[[providers]]
name = "openai"
key = "${OPENAI_KEY}"
# base_url = "https://api.openai.com/v1"

[[providers]]
name = "perplexity"
key = "${PERPLEXITY_KEY}"
# base_url = "https://api.perplexity.ai"

[[providers]]
name = "qwen"
key = "${QWEN_KEY}"
# base_url = "https://dashscope.aliyuncs.com/compatible-mode/v1"

[[providers]]
name = "sensenova"
key = "${SENSENOVA_KEY}"
# base_url = "https://api.sensenova.cn/v1"

[[providers]]
name = "siliconflow"
key = "${SILICONFLOW_KEY}"
# base_url = "https://api.siliconflow.cn/v1"

[[providers]]
name = "spark"
key = "${SPARK_KEY}"
# base_url = "https://spark-api-open.xf-yun.com/v1"

[[providers]]
name = "stepfun"
key = "${STEPFUN_KEY}"
# base_url = "https://api.stepfun.com/v1"

[[providers]]
name = "together"
key = "${TOGETHER_KEY}"
# base_url = "https://api.together.xyz/v1"

[[providers]]
name = "yi"
key = "${YI_KEY}"
# base_url = "https://api.lingyiwanwu.com/v1"


# Routing strategy: determines provider selection order (decorator chain)
[strategy]
primary = "glm"
fallback = ["minimax", "deepseek"]
# Skip provider when P99 latency exceeds this threshold (ms). 0 = unlimited
latency_threshold_ms = 5000

[server]
listen_addr = ":8084"
# api_keys = ["your-secret-key-1", "your-secret-key-2"]  # Bearer token auth; empty = no auth
# rate_limit_rpm = 600  # global requests per minute; 0 = unlimited
# admin_token = "your-secret"  # enables the web console at /admin/

# Harness: request recording, shadow traffic, and compliance probes
[harness]
# record = true                          # enable request/response recording
# record_path = "harness_records.jsonl"  # JSONL output file
# shadow_provider = ""                   # send shadow copies to this provider (empty = off)
# shadow_model = ""                      # override model for shadow requests (empty = use original)
# shadow_path = "harness_shadow.jsonl"   # shadow results file